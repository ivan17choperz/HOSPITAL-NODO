{
  "realm": "hospital",
  "enabled": true,
  "displayName": "Hospital System",
  "accessTokenLifespan": 3600,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "fhir-client",
      "enabled": true,
      "name": "FHIR Client",
